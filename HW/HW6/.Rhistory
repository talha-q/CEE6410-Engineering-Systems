library(mapboxer)
library(dplyr)
# Calculate center point
center1 <- c(
(bbox["xmin"] + bbox["xmax"]) / 2,
(bbox["ymin"] + bbox["ymax"]) / 2
)
# Adjust zoom based on bounding box size (example calculation)
bbox_width <- bbox["xmax"] - bbox["xmin"]
bbox_height <- bbox["ymax"] - bbox["ymin"]
zoom_level <- max(1, 15 - log2(max(bbox_width, bbox_height))) # Example formula
# Create map
map <- geo_data %>%
dplyr::mutate(
color = ifelse(PercentageOfLarvae > 5, "red", "blue")
) %>%
as_mapbox_source() %>%
mapboxer(
center = center1,
zoom = zoom_level
) %>%
add_navigation_control() %>%
add_circle_layer(
circle_color = c("get", "color"),
circle_blur = 1,
circle_stroke_color = "red",
circle_stroke_width = 1,
popup = "<p>Reef Name: {{SourceReef}}</p><p>Percentage of Larvae: {{PercentageOfLarvae}}</p>"
)
